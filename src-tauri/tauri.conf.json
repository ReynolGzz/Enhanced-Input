{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enhanced Input",
  "version": "0.1.0",
  "identifier": "com.enhancedinput.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Enhanced Input",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ReynolGzz/Enhanced-Input/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwOENCQUE2MEQzRUMyNTMKUldSVHdqNE5wcnFNVUlkYXkyQlhZZUFqVGRESkRzMWlZQ3VNVVBaNmdxSGF1YXZ4RE1WSGZndU4K"
    }
  }
}
